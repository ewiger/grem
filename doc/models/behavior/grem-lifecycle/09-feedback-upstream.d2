# 09 — Feedback: lessons flow UP (project → template)
# Retells section 9 of ../grem-lifecycle.md

direction: up

classes: {
  fail:   { style: { fill: "#fef2f2"; stroke: "#dc2626"; stroke-width: 2; font-color: "#991b1b"; border-radius: 8 } }
  issue:  { style: { fill: "#f9fafb"; stroke: "#6b7280"; stroke-width: 1; font-color: "#374151" } }
  tmpl:   { style: { fill: "#eef2ff"; stroke: "#4f46e5"; stroke-width: 2; font-color: "#312e81"; border-radius: 8 } }
  future: { style: { fill: "#ecfdf5"; stroke: "#059669"; stroke-width: 2; font-color: "#064e3b"; border-radius: 8 } }
}

title: "Dogfooding surfaces a gap that improves the template for everyone" {
  near: top-center
  shape: text
  style: { font-size: 23; bold: true; font-color: "#111827" }
}

clobber: "early upgrade CLOBBERED\npyproject.toml · README · CLAUDE.md;\npackage name left unresolved" { class: fail }
issue: "doc/issues/0001\n3 linked gaps:\n· no ownership list\n· no real parameters\n· no derived prefix" { class: issue; shape: page }
newver: "new template version\n· .gremignore\n· {{ project_name }}\n· proposal_prefix" { class: tmpl }
future: "every future grem init,\nanywhere, inherits the fix" { class: future }

clobber -> issue: "written up as" { style: { stroke: "#059669"; stroke-width: 3; stroke-dash: 4 } }
issue -> newver: "findings flow UP into" { style: { stroke: "#059669"; stroke-width: 3; stroke-dash: 4 } }
newver -> future: "seeds" { style: { stroke: "#059669"; stroke-width: 3 } }

note: "A lesson learned in one project becomes structure for every future one. This upward arrow closes the loop." {
  near: bottom-center
  shape: text
  style: { font-size: 13; italic: true; font-color: "#475569" }
}
